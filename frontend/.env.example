# AWS API Gateway Configuration
# Get this from your API Gateway console after deployment
# Format: https://{api-id}.execute-api.{region}.amazonaws.com
REACT_APP_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# Amazon Cognito Configuration
# Create a Cognito User Pool in AWS Console and get these values

# User Pool ID - Found in Cognito User Pool > General settings
# Format: {region}_{random-string}
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# App Client ID - Found in Cognito User Pool > App integration > App clients
# Format: alphanumeric string
REACT_APP_COGNITO_CLIENT_ID=your-app-client-id-here

# AWS Region where your Cognito User Pool is deployed
REACT_APP_COGNITO_REGION=us-east-1

# Test User Credentials (for development/testing only)
# Create a user in your Cognito User Pool and use those credentials
# IMPORTANT: Never commit actual credentials to version control!
REACT_APP_COGNITO_USERNAME=testuser@example.com
REACT_APP_COGNITO_PASSWORD=YourSecurePassword123!

# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual AWS resource IDs
# 3. Create a test user in your Cognito User Pool
# 4. Update the username and password with your test user credentials
# 5. Never commit the .env file to version control (it's in .gitignore)
